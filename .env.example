# Backend / ops vars: root scripts + `supabase functions serve --env-file .env.local`.
# App vars (NEXT_PUBLIC_*) live in apps/web/.env.example.
SUPABASE_URL=https://your-project.supabase.co

# Strava integration (used by edge function + scripts/strava-auth.mjs)
STRAVA_CLIENT_ID=your-strava-client-id
STRAVA_CLIENT_SECRET=your-strava-client-secret
STRAVA_TOKEN_KEY=your-encryption-key
CRON_SECRET=your-cron-secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Knowledge Base MCP edge function (kb-mcp), bearer token for clients
KB_MCP_TOKEN=your-kb-mcp-token
