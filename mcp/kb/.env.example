# Knowledge Base MCP server config. Copy to mcp/kb/.env (gitignored).
# Env vars set by the MCP host override these.

# Target Supabase project (prod: https://<ref>.supabase.co, local: http://127.0.0.1:54221)
KB_SUPABASE_URL=https://your-project.supabase.co
KB_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# User with `manager` role on table `knowledge` (RLS gates writes).
KB_EMAIL=you@example.com
KB_PASSWORD=your-password

# Optional. Used to build entry URLs in tool results.
# KB_SITE_URL=https://www.soup.one
